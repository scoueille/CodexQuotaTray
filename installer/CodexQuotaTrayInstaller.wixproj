<Project Sdk="WixToolset.Sdk/6.0.2">
  <!-- Les fichiers installés proviennent de l'exécutable autonome préparé dans app-single. -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>CodexQuotaTray</OutputName>
    <Platform>x64</Platform>
    <DefineConstants>PayloadDir=$(MSBuildProjectDirectory)\app-single</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
