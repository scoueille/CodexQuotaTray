<Project Sdk="Microsoft.NET.Sdk">
  <!-- Application WinForms autonome sous forme d'icône de notification Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UIAutomationClient belongs to the Windows desktop reference pack. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexQuotaTray</AssemblyName>
    <RootNamespace>CodexQuotaTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>Codex Quota Tray</Title>
    <Product>Codex Quota Tray</Product>
    <Version>1.1.12</Version>
    <AssemblyVersion>1.1.12.0</AssemblyVersion>
    <FileVersion>1.1.12.0</FileVersion>
    <InformationalVersion>1.1.12</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- Les sources WiX sont présentées par leur projet dédié; les artefacts locaux ne polluent pas le projet C#. -->
    <None Remove="installer\**\*;publish\**\*;CodexQuotaTray-Setup-win-x64.msi;CodexQuotaTray-win-x64.zip;CodexQuotaTray-win-x64\**\*" />
    <!-- Le projet de test a son propre assemblage et ne doit pas être compilé dans l'application. -->
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
